---
extends: default

ignore: |
  .git/
  .lab/
  node_modules/
  infra/ansible/inventories/lab/

rules:
  line-length:
    max: 140
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
